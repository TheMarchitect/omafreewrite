# Maintainer: Russell Lundstrom <russell@marketingplanformula.com>

pkgname=omafreewrite
pkgver=0.1.0
pkgrel=1
pkgdesc='Focused Markdown writing app: the screen goes black down to one line while you write'
arch=('x86_64')
url='https://github.com/TheMarchitect/omafreewrite'
license=('MIT')
install='omafreewrite.install'
depends=('qt6-base' 'qt6-declarative' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/omafreewrite "$pkgdir/usr/bin/omafreewrite"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 "$startdir/omafreewrite.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omafreewrite.svg"
  /usr/bin/install -Dm644 "$startdir/omafreewrite.desktop" "$pkgdir/usr/share/applications/omafreewrite.desktop"
}
